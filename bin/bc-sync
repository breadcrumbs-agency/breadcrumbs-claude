#!/bin/sh
# The hook of SessionStart and SessionEnd: `bc sync claude-code` in the background, so the memories and the viewers follow the
# sessions of Claude Code. One at a time: a sync that runs (its lock folder is younger than ten minutes) is not started again.
# It prints nothing and always exits 0, so it never blocks or fails a session. BREADCRUMBS_SYNC=off turns it off.
case "$BREADCRUMBS_SYNC" in off|0|no|false) exit 0 ;; esac
here=$(cd "$(dirname "$0")" && pwd)
lock="${TMPDIR:-/tmp}/breadcrumbs-claude-sync.lock"
[ -d "$lock" ] && [ -n "$(find "$lock" -maxdepth 0 -mmin +10 2>/dev/null)" ] && rmdir "$lock" 2>/dev/null
mkdir "$lock" 2>/dev/null || exit 0
nohup sh -c 'sh "$1" sync claude-code >/dev/null 2>&1; rmdir "$2"' sh "$here/bc" "$lock" >/dev/null 2>&1 </dev/null &
exit 0
